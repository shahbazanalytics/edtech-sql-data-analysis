    <worksheet name='Course Performance - Completion'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Semibold' fontsize='12'>Course Completion Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='edtech_enrollment_analytics' name='federated.0vwti4p1xjpfbm1can98j0oab1eo' />
          </datasources>
          <datasource-dependencies datasource='federated.0vwti4p1xjpfbm1can98j0oab1eo'>
            <column caption='Completion Rate' datatype='real' name='[Calculation_0546214721187840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [progress_percent] = 100 THEN 1 ELSE 0 END&#13;&#10;) / COUNTD([enrollment_id])' />
            </column>
            <column caption='Average Progress' datatype='real' name='[Calculation_0546214722793473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([progress_percent]) / 100' />
            </column>
            <column-instance column='[category]' derivation='Attribute' name='[attr:category:nk]' pivot='key' type='nominal' />

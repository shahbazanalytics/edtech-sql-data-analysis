      <aliases enabled='yes' />
      <column caption='Completion Rate' datatype='real' name='[Calculation_0546214721187840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [progress_percent] = 100 THEN 1 ELSE 0 END&#13;&#10;) / COUNTD([enrollment_id])' />
      </column>
      <column caption='Average Progress' datatype='real' name='[Calculation_0546214722793473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([progress_percent]) / 100' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0546214724538370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([price])' />
      </column>
